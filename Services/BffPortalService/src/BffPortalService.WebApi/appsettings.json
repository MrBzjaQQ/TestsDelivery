{
  "AppName": "bff-portal-service:test",
  "AllowedHosts": "*",
  "ConnectionString": "Host=localhost;Port=5432;Database=testsdelivery_bff;Username=postgres;Password=postgres",
  "Jwt": {
    "SecretKey": "bff-portal-secret-key-for-development-min-32-chars",
    "Issuer": "TestsDelivery",
    "Audience": "TestsDelivery",
    "ExpirationMinutes": 60
  },
  "ServiceUrls": {
    "IdentityServiceUrl": "http://localhost:8081",
    "QuestionServiceUrl": "http://localhost:8082",
    "StudentServiceUrl": "http://localhost:8083",
    "TestCheckingServiceUrl": "http://localhost:8084",
    "FileStorageServiceUrl": "http://localhost:8085",
    "NotificationServiceUrl": "http://localhost:8086"
  },
  "Cache": {
    "StudentProfileDurationMinutes": 5,
    "AvailableTestsDurationMinutes": 10,
    "GroupAnalyticsDurationMinutes": 15,
    "TestQuestionsDurationMinutes": 60
  },
  "HealthChecks": {
    "Enabled": true,
    "DatabaseTimeoutSeconds": 5,
    "ExternalServiceTimeoutSeconds": 3
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  }
}
